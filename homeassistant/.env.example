# Copy to .env (git-ignored) and fill in.
TZ=America/Los_Angeles

# Lorex NVR: its IP on the house network and a user made for this (Lorex app or NVR menu → Users).
LOREX_NVR_HOST=192.168.1.20
LOREX_NVR_USER=frigate
LOREX_NVR_PASSWORD=change-me

# MQTT user for Frigate (create it with the mosquitto_passwd command in SETUP.md).
MQTT_FRIGATE_USER=frigate
MQTT_FRIGATE_PASSWORD=change-me
